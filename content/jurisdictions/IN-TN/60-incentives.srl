package IN.TN

// Schemes and entitlements.
//
// Eligibility runs on the same deterministic engine, over the same profile, as
// the approvals (spec 5.14). That is what makes an entitlement explainable and
// auditable rather than a leaflet: the applicant is told what they qualify for,
// which provision says so, and what it is worth.

incentive INC.TN.CAPITAL_SUBSIDY {
  title en "Capital subsidy for micro and small enterprises"
  scheme "Tamil Nadu MSME Policy"
  department TN.MSME_DEPT
  value = min(0.25 * profile.investment_plant_machinery, INR 30 lakh)
  window from 2021-04-01 until 2027-03-31
  evidence [ DOC.UDYAM, DOC.PROJECT_REPORT, DOC.EB_CARD ]
  apply_url "https://msmeonline.tn.gov.in"
  legal_basis {
    act "Tamil Nadu Micro, Small and Medium Enterprises Policy, 2021"
    section "Capital subsidy"
  }
  owner "Secretary, MSME Department"
  review_status unverified
  review_cadence 1 year
}

incentive INC.TN.AGRO_ADDITIONAL_SUBSIDY {
  title en "Additional capital subsidy for agro and food processing"
  scheme "Tamil Nadu MSME Policy — thrust sectors"
  department TN.MSME_DEPT
  value = min(0.05 * profile.investment_plant_machinery, INR 5 lakh)
  window from 2021-04-01 until 2027-03-31
  evidence [ DOC.UDYAM, DOC.PROJECT_REPORT ]
  apply_url "https://msmeonline.tn.gov.in"
  legal_basis {
    act "Tamil Nadu Micro, Small and Medium Enterprises Policy, 2021"
    section "Thrust sector additional subsidy"
  }
  owner "Secretary, MSME Department"
  review_status unverified
  review_cadence 1 year
}

