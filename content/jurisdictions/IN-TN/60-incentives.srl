incentive INC.IN.PMFME {
  title en "Credit-linked subsidy for micro food processing enterprises"
  scheme "PM Formalisation of Micro Food Processing Enterprises"
  department IN.MSME
  value = min(0.35 * profile.investment_plant_machinery, INR 10 lakh)
  window from 2020-06-29 until 2026-03-31
  evidence [ DOC.UDYAM, DOC.PROJECT_REPORT ]
  apply_url "https://pmfme.mofpi.gov.in"
  legal_basis {
    act "PM Formalisation of Micro Food Processing Enterprises Scheme Guidelines"
    section "Credit-linked capital subsidy"
  }
  owner "Development Commissioner (MSME)"
  review_status unverified
  review_cadence 1 year
}

