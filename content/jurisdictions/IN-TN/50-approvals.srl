package IN.TN

// Approval types.
//
// `deemed_approval` records whether the law permits an application to be
// treated as granted when the statutory period expires, and cites the provision
// that permits it. Where no provision exists it is `prohibited`, and the
// orchestrator cannot be configured to grant one however long the department
// takes (P3, spec 5.7). Silence is not consent unless a statute says it is.
//
// `depends_on` is a legal ordering constraint, not a workflow preference. It
// means the second approval cannot be granted before the first, and it carries
// the applicant-facing reason shown while a case is waiting.

approval TN.UDYAM.REGISTRATION {
  title en "Udyam registration"
  summary en "The MSME registration that unlocks most state and central incentives."
  category "registration"
  department IN.MSME
  jurisdiction IN.TN
  sla 1 day
  documents [ DOC.PAN, DOC.GSTIN ]
  legal_basis {
    act "Micro, Small and Medium Enterprises Development Act, 2006"
    section "8"
    notification "S.O. 2119(E)"
    dated 2020-06-26
  }
  deemed_approval prohibited
  effective from 2020-07-01
  owner "Development Commissioner (MSME)"
  review_status unverified
  review_cadence 1 year
}

approval IN.GST.REGISTRATION {
  title en "GST registration"
  category "registration"
  department IN.GSTN
  jurisdiction IN.TN
  sla 7 days
  documents [ DOC.PAN, DOC.INCORPORATION, DOC.LAND_TITLE ]
  legal_basis {
    act "Central Goods and Services Tax Act, 2017"
    section "22"
    rule "Central Goods and Services Tax Rules, 2017, Rule 9"
  }
  // Rule 9(5) treats an application as approved if the officer does not act
  // within the prescribed period.
  deemed_approval permitted section "Rule 9(5)"
  effective from 2017-07-01
  owner "Commissioner of Commercial Taxes"
  review_status unverified
  review_cadence 1 year
}

approval TN.PLANNING.BUILDING_DTCP {
  title en "Planning permission and building plan approval"
  summary en "Permission to build, from the planning authority for the area."
  category "permit"
  department TN.DTCP
  jurisdiction IN.TN
  sla 30 days
  validity 3 years
  renewal { notice 90 days cadence 3 years }
  documents [ DOC.LAND_TITLE, DOC.SITE_PLAN, DOC.PROJECT_REPORT ]
  fees [ FEE.PLANNING.SCRUTINY ]
  appeal { authority en "Director of Town and Country Planning" within 30 days }
  legal_basis {
    act "Tamil Nadu Town and Country Planning Act, 1971"
    section "49"
    rule "Tamil Nadu Combined Development and Building Rules, 2019"
  }
  deemed_approval prohibited
  effective from 1972-01-01
  owner "Director of Town and Country Planning"
  review_status unverified
  review_cadence 1 year
}

