  documents [ DOC.LAND_TITLE, DOC.SITE_PLAN, DOC.PROJECT_REPORT ]
  fees [ FEE.PLANNING.SCRUTINY ]
  appeal { authority en "Government of Tamil Nadu, Housing and Urban Development Department" within 30 days }
  legal_basis {
    act "Tamil Nadu Town and Country Planning Act, 1971"
    section "49"
    rule "Chennai Metropolitan Development Authority Development Regulations"
  }
  deemed_approval prohibited
  effective from 1975-01-01
  owner "Member Secretary, CMDA"
  review_status unverified
  review_cadence 1 year
}

approval TN.FIRE.NOC {
  title en "Fire service no-objection certificate"
  category "noc"
  department TN.FIRE
  jurisdiction IN.TN
  sla 30 days
  validity 1 year
  renewal { notice 60 days cadence 1 year }
  documents [ DOC.SITE_PLAN, DOC.FIRE_SAFETY_PLAN ]
  fees [ FEE.FIRE.NOC ]
  // The fire NOC waits on planning permission, but only on the one authority
  // that actually has jurisdiction over the site. Declaring both here would
  // make them cumulative — dependencies are conjunctive — so the edge is
  // created conditionally by R.DEP.FIRE_ON_PLANNING instead.
  appeal { authority en "Director, Fire and Rescue Services" within 30 days }
  legal_basis {
    act "Tamil Nadu Fire Service Act, 1985"
    section "13"
  }
  deemed_approval prohibited
  effective from 1985-01-01
  owner "Director, Fire and Rescue Services"
  review_status unverified
  review_cadence 1 year
}

