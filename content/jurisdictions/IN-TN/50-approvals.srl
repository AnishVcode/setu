approval TN.DISH.FACTORY_LICENCE {
  title en "Factory licence"
  summary en "The licence to run a factory, renewed annually."
  category "licence"
  department TN.DISH
  jurisdiction IN.TN
  sla 30 days
  validity 1 year
  renewal { notice 60 days cadence 1 year }
  documents [ DOC.LAND_TITLE, DOC.MACHINERY_LAYOUT, DOC.WORKER_LIST ]
  fees [ FEE.FACTORY.LICENCE ]
  obligations [ OBL.FACTORY.ANNUAL_RETURN, OBL.FACTORY.LICENCE_RENEWAL ]
  depends_on {
    TN.DISH.FACTORY_PLAN {
      reason en "The licence is granted against approved plans, so the plan approval must come first."
    }
  }
  appeal { authority en "Chief Inspector of Factories" within 30 days }
  legal_basis {
    act "Factories Act, 1948"
    section "6"
    rule "Tamil Nadu Factories Rules, 1950, Rule 4"
  }
  deemed_approval prohibited
  effective from 1950-01-01
  owner "Joint Director (Licensing)"
  review_status unverified
  review_cadence 1 year
}

