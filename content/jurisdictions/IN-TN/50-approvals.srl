  title en "Planning permission — Chennai Metropolitan Area"
  summary en "Planning permission inside the Chennai Metropolitan Area, issued by CMDA rather than the Directorate."
  category "permit"
  department TN.CMDA
  jurisdiction IN.TN
  sla 30 days
