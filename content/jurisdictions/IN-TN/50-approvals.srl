  fees [ FEE.TNPCB.CTO ]
  obligations [ OBL.TNPCB.CTO_RENEWAL, OBL.TNPCB.WATER_CESS_RETURN ]
  depends_on {
    TN.TNPCB.CTE {
      reason en "The Board grants consent to operate only against an existing consent to establish."
    }
  }
  appeal { authority en "Tamil Nadu Appellate Authority under the Water and Air Acts" within 30 days }
  legal_basis {
    act "Water (Prevention and Control of Pollution) Act, 1974"
    section "25"
  }
  deemed_approval prohibited
  effective from 1974-03-23
  owner "Joint Chief Environmental Engineer"
  review_status unverified
  review_cadence 1 year
}

