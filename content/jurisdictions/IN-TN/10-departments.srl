package IN.TN

// Statutory authorities.
//
// adapter_tier records how SETU integrates with each one today. Spec P4 makes
// partial adoption a first-class state: a department at the `assisted_manual`
// tier still appears to the applicant exactly like any other, while its
// back-office remains a structured work queue until an API exists.

department TN.DTCP {
  name en "Directorate of Town and Country Planning"
  jurisdiction IN.TN
  adapter_tier api
  contact_url "https://tnlpa.tn.gov.in"
  owner "Director of Town and Country Planning"
  review_status unverified
  review_cadence 1 year
}

department TN.CMDA {
  name en "Chennai Metropolitan Development Authority"
  jurisdiction IN.TN
  adapter_tier api
  owner "Member Secretary, CMDA"
  review_status unverified
  review_cadence 1 year
}

